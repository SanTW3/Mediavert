    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aifc\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ogg\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.oga\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.opus\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4a\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aac\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wma\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.alac\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.amr\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ape\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wv\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ac3\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mka\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.caf\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp2\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.au\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.snd\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp4\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mov\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mkv\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.avi\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webm\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wmv\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.flv\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4v\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mpg\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mpeg\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.3gp\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ts\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mts\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m2ts\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.vob\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ogv\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gif\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.png\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpg\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpeg\shell\MediaShift"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jfif\shell\MediaShift"
